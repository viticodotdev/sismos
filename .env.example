# ntfy server (self-hosted)
NTFY_BASE_URL=https://ntfy.example.com
NTFY_TOPIC=earthquakes
# leave empty if the server allows anonymous publish
NTFY_ACCESS_TOKEN=

# region selection (comma-separated ids from src/regions.ts, or "all" = blanket)
REGIONS=dr
# minimum magnitude (0 = all)
MIN_MAGNITUDE=0

# felt source (independent of the feed): fires on a NEW felt event once it
# reaches felt-alert-at reports, and on a JUMP when the count climbs by at
# least felt-jump-by. Signals "people are feeling this" — a quake the feed
# might have missed or that's getting worse.
FELT_ALERT_AT=5       # min felt reports to alert on a new felt event (0=off)
FELT_JUMP_BY=15       # felt-count climb that triggers a jump alert (0=off)
FELT_COOLDOWN_MIN=30  # suppress repeat alerts for the same event within this window

# Self-host mode (Docker): container polls itself. Vercel deployments leave
# these unset and use the Managed Cron instead.
SELF_POLL=true
POLL_INTERVAL_MINUTES=5
# "0" = publish real alerts; "1" = dry-run (report only)
DRY_RUN=0

# Real-time websocket feed (self-host only) — the primary feed source; the REST
# self-poll remains as a watchdog/backstop. Disable with WS_FEED=false.
WS_FEED=true
# revision alert when a quake's magnitude shifts by at least this much (or
# crosses the MIN_MAGNITUDE floor) after its initial create.
UPDATE_ALERT_MAG_DELTA=0.3
